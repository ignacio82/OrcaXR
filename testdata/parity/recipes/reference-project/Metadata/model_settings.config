<?xml version="1.0" encoding="UTF-8"?>
<config>
  <object id="1">
    <metadata key="name" value="Two-part assembly"/>
    <metadata key="extruder" value="1"/>
    <part id="2" subtype="normal_part">
      <metadata key="extruder" value="2"/>
      <metadata key="wall_filament" value="5"/>
      <metadata key="support_filament" value="1"/>
    </part>
    <part id="3" subtype="modifier">
      <metadata key="sparse_infill_density" value="35%"/>
    </part>
    <layer_range min_z="2.0" max_z="5.0">
      <metadata key="layer_height" value="0.12"/>
      <metadata key="wall_filament" value="6"/>
    </layer_range>
  </object>
  <object id="4">
    <part id="4" subtype="negative_volume">
      <metadata key="name" value="Subtractive tetrahedron"/>
    </part>
  </object>
  <plate id="1" name="Primary" locked="0" printable="1">
    <model_instance object_id="1" instance_id="0"/>
    <model_instance object_id="4" instance_id="0"/>
  </plate>
  <plate id="2" name="Secondary" locked="1" printable="0">
    <model_instance object_id="1" instance_id="1"/>
  </plate>
</config>

