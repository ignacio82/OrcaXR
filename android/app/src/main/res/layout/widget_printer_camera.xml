<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <!-- Header bar -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="2dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_camera_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_widget_camera"
            android:contentDescription="@string/widget_camera_name"
            android:tint="#A1A1AA" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_camera_name"
                android:textColor="#F4F4F5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_camera_tap_to_refresh"
                android:textColor="#A1A1AA"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_btn_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="@string/widget_camera_refresh"
            android:tint="#D4D4D8"
            android:padding="6dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- Camera content container -->
    <FrameLayout
        android:id="@+id/widget_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_image_container">

        <!-- Captured camera image -->
        <ImageView
            android:id="@+id/widget_camera_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_camera_name"
            android:visibility="gone" />

        <!-- Placeholder when no frame yet / error -->
        <LinearLayout
            android:id="@+id/widget_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <ImageView
                android:id="@+id/widget_placeholder_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_widget_camera"
                android:tint="#71717A"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_placeholder_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/widget_camera_tap_to_refresh"
                android:textColor="#71717A"
                android:textSize="12sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Progress spinner when refreshing -->
        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
