<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose: the browser's window colour for the system's theme
         (orca_colors.xml, generated by tools/cross-platform/android-tokens.mjs), so a
         start in the dark theme shows no white frame before the first draw. -->
    <style name="Theme.OrcaXR" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/orca_window</item>
    </style>
</resources>
