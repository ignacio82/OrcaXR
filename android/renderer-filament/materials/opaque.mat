material {
    name : OrcaXRFacet,
    shadingModel : unlit,
    doubleSided : true,
    requires : [color],
    parameters : [
        { type : float, name : clipHeight },
        { type : float, name : opacity },
        { type : float4, name : tint },
        { type : float4, name : highlight }
    ]
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        if (getUserWorldPosition().y > materialParams.clipHeight) discard;
        // A vertex's alpha says whether the draw's tint applies (1) or the
        // vertex keeps its own colour (0: a painted facet); the highlight then
        // moves the colour toward the selection accent by its alpha.
        vec4 color = getColor();
        vec3 rgb = mix(color.rgb, color.rgb * materialParams.tint.rgb, color.a);
        rgb = mix(rgb, materialParams.highlight.rgb, materialParams.highlight.a);
        material.baseColor = vec4(rgb, materialParams.tint.a * materialParams.opacity);
    }
}
