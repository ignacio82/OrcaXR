{
  "name": "orcaxr-web",
  "version": "0.1.0",
  "private": true,
  "description": "OrcaXR pure-web front-end: XR Blocks + three.js workspace with WASM slicing (in progress)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icons:vendor": "node scripts/vendor-xr-icons.mjs --write",
    "icons:verify": "node scripts/vendor-xr-icons.mjs",
    "parity:extract": "node ../tools/parity/extract.mjs",
    "parity:verify": "node ../tools/parity/verify.mjs && node ../tools/parity/test.mjs && node ../tools/parity/extract.mjs --check",
    "profiles:sync": "node scripts/verify-pinned-profile-overlays.mjs --write && node scripts/generate-profile-catalog.mjs",
    "profiles:verify": "node scripts/verify-pinned-profile-overlays.mjs && node scripts/generate-profile-catalog.mjs --check",
    "calibration:sync": "node scripts/generate-calibration-inventory.mjs",
    "calibration:verify": "node scripts/generate-calibration-inventory.mjs --check",
    "settings:verify": "npm run profiles:verify && node ../tools/settings-schema/generate.mjs --check && node ../tools/settings-schema/self-test.mjs",
    "security:check": "node scripts/security-contract.mjs",
    "offline:check": "node scripts/offline-contract.mjs",
    "architecture:check": "node tools/check-import-boundaries.mjs",
    "parity:oracles": "node ../tools/parity-oracles/generate-fixtures.mjs --check && node ../tools/parity-oracles/self-test.mjs",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"scripts/**/*.mjs\" \"tools/**/*.mjs\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\" \"scripts/**/*.mjs\" \"tools/**/*.mjs\" \"*.{js,ts,json}\"",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node scripts/run-tests.mjs",
    "test:integration": "node scripts/run-tests.mjs project3mf.test.ts local-network.test.ts webmcp-client.test.ts",
    "test:local-network": "node scripts/run-tests.mjs local-network.test.ts",
    "test:project": "node scripts/run-tests.mjs src/project/",
    "test:settings": "node scripts/run-tests.mjs src/settings/",
    "test:xr": "node scripts/run-tests.mjs xr-shell.test.ts",
    "test:e2e": "npm run build && npm run offline:check && node scripts/e2e-smoke.mjs && node scripts/offline-smoke.mjs",
    "test:a11y": "npm run build && node scripts/a11y-smoke.mjs",
    "size:check": "node scripts/size-check.mjs",
    "quality": "npm run icons:verify && npm run security:check && npm run format:check && npm run lint && npm run typecheck && npm run architecture:check && npm run test:unit && npm run test:integration && npm run test:project && npm run test:settings && npm run test:xr && npm run parity:verify && npm run settings:verify && npm run calibration:verify && npm run parity:oracles && npm run test:e2e && npm run test:a11y && npm run size:check"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@mediapipe/tasks-audio": "^0.10.35",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@pmndrs/uikit": "1.0.74",
    "@preact/signals-core": "^1.14.3",
    "@sparkjsdev/spark": "^2.1.0",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "lit": "^3.3.3",
    "openai": "^6.45.0",
    "puppeteer": "^25.3.0",
    "serve-handler": "^6.1.7",
    "three": "^0.184.0",
    "three-mesh-bvh": "^0.9.10",
    "troika-three-text": "^0.52.4",
    "xrblocks": "0.17.0",
    "yoga-layout-prebuilt": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@material-symbols/svg-400": "0.33.0",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "axe-core": "4.12.1",
    "draco3d": "^1.5.7",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.64.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
