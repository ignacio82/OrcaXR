+// OrcaXR Android (FullSpectrum patch 0044). Local-Z dithering planner
+// cache. The sublayer planner subdivides Z intervals containing painted
+// mixed-filament regions into thinner sublayers; the unpainted majority
+// of the print continues at base layer height.
+//
+// LocalZInterval describes one source layer's worth of sublayer plan:
+// the base height, the sublayer thickness, and an index range into the
+// PrintObject's m_local_z_sublayer_plan vector for the actual
+// SubLayerPlan entries.
+struct LocalZInterval
+{
+    size_t layer_id { 0 };
+    double z_lo { 0.0 };
+    double z_hi { 0.0 };
+    double base_height { 0.0 };
+    double sublayer_height { 0.0 };
+    bool   has_mixed_paint { false };
+    size_t first_sublayer_idx { 0 };
+    size_t sublayer_count { 0 };
+};
+
+// SubLayerPlan describes one sub-slice of a Local-Z interval.
+// `painted_masks_by_extruder[i]` carries the XY mask for physical
+// extruder i at this sublayer's print_z. `fixed_painted_masks_by_extruder`
+// is the same but for "fixed" (manual-pattern) component placement
+// that mustn't be redistributed by the cadence resolver. `base_masks`
+// is the unpainted-region mask. `dependency_group` + `dependency_order`
+// let the LocalZOrderOptimizer (patch 0023) sort sublayers within a
+// group to minimize toolchanges.
+struct SubLayerPlan
+{
+    size_t layer_id { 0 };
+    size_t pass_index { 0 };
+    bool   split_interval { false };
+    double z_lo { 0.0 };
+    double z_hi { 0.0 };
+    double print_z { 0.0 };
+    double flow_height { 0.0 };
+    size_t dependency_group { 0 };
+    size_t dependency_order { 0 };
+    std::vector<ExPolygons> painted_masks_by_extruder;
+    std::vector<ExPolygons> fixed_painted_masks_by_extruder;
+    ExPolygons              base_masks;
+};
