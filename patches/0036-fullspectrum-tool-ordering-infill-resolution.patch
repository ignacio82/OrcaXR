 	const unsigned int filament_1based = (this->extruder_override == 0) ? region.config().solid_infill_filament.value : this->extruder_override;
-	return this->resolve_mixed_1based(filament_1based) - 1;
+	const unsigned int grouped = grouped_manual_pattern_infill_filament_1based(*this, region, filament_1based);
+	return ((grouped != 0) ? grouped : resolve_mixed_1based(filament_1based)) - 1;
 }
 
