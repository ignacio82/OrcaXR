diff --git a/src/libslic3r/PrintObject.cpp b/src/libslic3r/PrintObject.cpp
index dc3ce14be4..96134c7ee1 100644
--- a/src/libslic3r/PrintObject.cpp
+++ b/src/libslic3r/PrintObject.cpp
@@ -1081,6 +1081,16 @@ bool PrintObject::invalidate_state_by_config_options(
             steps.emplace_back(posPerimeters);
         } else if (
                opt_key == "layer_height"
+            // OrcaXR Android (FullSpectrum patch 0037). FS dithering +
+            // mixed-filament keys: changing any of these forces a re-slice
