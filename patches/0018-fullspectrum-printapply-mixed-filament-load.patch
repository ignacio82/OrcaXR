+    // FullSpectrum: refresh the mixed-filament manager from the user's
+    // serialized definitions. Keeping it here (after m_config is up to
+    // date with new_full_config and num_extruders is finalized) means
+    // the manager always reflects the latest slice request. Downstream
+    // code (ToolOrdering expansion, 3MF metadata) reads from it; until
+    // those phases land, this is silent state — but persisting it now
+    // means the engine carries everything it needs the moment those
+    // consumers wire up.
+    {
+        std::vector<std::string> physical_filament_colors = m_config.filament_colour.values;
+        physical_filament_colors.resize(num_extruders, std::string("#26A69A"));
+        // Read the FullSpectrum keys off new_full_config — m_config is the
+        // typed PrintConfig struct and these keys aren't materialized as
+        // typed members, only as ConfigOptionDef entries (patch 0016).
+        // new_full_config is the freshest user-supplied DynamicPrintConfig
+        // and exposes the opt_string/opt_int/opt_float helpers.
+        // mixed_filament_gradient_mode + mixed_filament_advanced_dithering
+        // are registered as coBool (PrintConfig.cpp). Calling opt_int on a
+        // ConfigOptionBool dynamic_casts to ConfigOptionInt, gets nullptr,
+        // and SEGVs at the value field offset (0x8). Read them via
+        // opt_bool / option<ConfigOptionBool>() instead.
+        auto opt_bool_or = [&new_full_config](const char *key, bool fallback) {
+            const auto *opt = new_full_config.option<ConfigOptionBool>(key);
+            return opt ? opt->value : fallback;
+        };
+        auto opt_string_or = [&new_full_config](const char *key, std::string fallback) {
+            const auto *opt = new_full_config.option<ConfigOptionString>(key);
+            return opt ? opt->value : fallback;
+        };
+        auto opt_float_or = [&new_full_config](const char *key, double fallback) {
+            const auto *opt = new_full_config.option<ConfigOptionFloat>(key);
+            return opt ? opt->value : fallback;
+        };
+        const std::string mixed_definitions = opt_string_or("mixed_filament_definitions", "");
+        const int   gradient_mode  = opt_bool_or("mixed_filament_gradient_mode", false) ? 1 : 0;
+        const float lower_in       = float(opt_float_or("mixed_filament_height_lower_bound", 0.04));
+        const float upper_in       = float(opt_float_or("mixed_filament_height_upper_bound", 0.16));
+        const float height_lower   = std::max(0.01f, lower_in);
+        const float height_upper   = std::max(height_lower, upper_in);
+        const bool  advanced_dith  = opt_bool_or("mixed_filament_advanced_dithering", false);
+        m_mixed_filament_mgr.clear_custom_entries();
+        m_mixed_filament_mgr.auto_generate(physical_filament_colors);
+        m_mixed_filament_mgr.load_custom_entries(mixed_definitions, physical_filament_colors);
+        m_mixed_filament_mgr.apply_gradient_settings(gradient_mode, height_lower, height_upper, advanced_dith);
+        BOOST_LOG_TRIVIAL(info) << __FUNCTION__
+                                << boost::format(": mixed-filament manager refreshed, total=%1%, enabled=%2%, definitions_len=%3%")
+                                       % m_mixed_filament_mgr.mixed_filaments().size()
+                                       % m_mixed_filament_mgr.enabled_count()
+                                       % mixed_definitions.size();
+    }
+
