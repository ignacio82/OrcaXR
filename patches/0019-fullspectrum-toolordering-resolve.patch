+// OrcaXR Android (FullSpectrum integration). Resolve a 1-based filament
+// ID through the mixed-filament manager for this LayerTools. Returns the
+// input unchanged when no manager is attached, when the ID is 0 (don't-
+// care), or when the ID refers to a physical filament. For virtual
+// mixed-filament IDs (filament_id > num_physical) this returns the per-
+// layer physical extruder selected by MixedFilamentManager::resolve.
+unsigned int LayerTools::resolve_mixed_1based(unsigned int filament_id) const
+{
+    if (filament_id == 0 || this->mixed_mgr == nullptr || this->num_physical == 0)
+        return filament_id;
+    if (filament_id <= this->num_physical)
+        return filament_id;
+    return this->mixed_mgr->resolve(filament_id,
+                                    this->num_physical,
+                                    this->layer_index,
+                                    float(this->print_z),
+                                    float(this->layer_height_for_mixed));
+}
