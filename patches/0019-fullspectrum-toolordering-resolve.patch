 void PrintRegion::collect_object_printing_extruders(const Print &print, std::vector<unsigned int> &object_extruders) const
 {
+    // OrcaXR Android (FullSpectrum integration). When painted regions
+    // carry virtual mixed-filament IDs (wall_filament > num_physical),
+    // expand them into their underlying physical components before
+    // letting the upstream helper run — that helper clamps any id >=
+    // num_extruders to 0 (T0), which silently swallows virtual IDs and
+    // makes the region appear to print on T0 only. We instead push each
+    // component A / B (1-based, dedupe) so per-extruder buffer
+    // allocations downstream see the real physicals.
+    const size_t num_physical = print.config().filament_diameter.size();
+    const MixedFilamentManager &mixed_mgr = print.mixed_filament_manager();
+    auto resolve_or_collect_components = [&](unsigned int id_1based) -> unsigned int {
+        if (id_1based == 0 || id_1based <= num_physical)
+            return id_1based;
+        const MixedFilament *mf = mixed_mgr.mixed_filament_from_id(id_1based, num_physical);
+        if (mf == nullptr)
+            return id_1based;
+        // Push the *secondary* component now (component_b unless it
+        // equals component_a). The primary (component_a) becomes the
+        // value we pass to the upstream helper, which adds it via
+        // emplace_extruder.
+        if (mf->component_b >= 1 && mf->component_b <= num_physical && mf->component_b != mf->component_a)
+            object_extruders.emplace_back(mf->component_b - 1);
+        return mf->component_a;
+    };
+
+    PrintRegionConfig effective_cfg = this->config();
+    effective_cfg.wall_filament.value         = static_cast<int>(resolve_or_collect_components(static_cast<unsigned int>(effective_cfg.wall_filament.value)));
+    effective_cfg.sparse_infill_filament.value = static_cast<int>(resolve_or_collect_components(static_cast<unsigned int>(effective_cfg.sparse_infill_filament.value)));
+    effective_cfg.solid_infill_filament.value = static_cast<int>(resolve_or_collect_components(static_cast<unsigned int>(effective_cfg.solid_infill_filament.value)));
+
     // PrintRegion, if used by some PrintObject, shall have all the extruders set to an existing printer extruder.
     // If not, then there must be something wrong with the Print::apply() function.
 #ifndef NDEBUG
     // BBS
     auto num_extruders = int(print.config().filament_diameter.size());
-    assert(this->config().wall_filament    <= num_extruders);
-    assert(this->config().sparse_infill_filament       <= num_extruders);
-    assert(this->config().solid_infill_filament <= num_extruders);
+    assert(effective_cfg.wall_filament         <= num_extruders);
