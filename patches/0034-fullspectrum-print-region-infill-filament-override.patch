 namespace Slic3r {
 
+namespace {
+
+// OrcaXR Android (FullSpectrum patch 0034). When the
+// enable_infill_filament_override toggle is off, the prior FS code's
+// "implicit override" rule kicked in: sparse_infill_filament was treated
+// as an override whenever it differed from wall_filament. The new
+// explicit toggle makes the override opt-in; helpers here resolve the
+// effective infill filament according to it.
+unsigned int effective_sparse_infill_filament(const PrintRegionConfig &config)
+{
+    return config.enable_infill_filament_override.value ? config.sparse_infill_filament.value : config.wall_filament.value;
+}
+
+// Internal solid infill at 100% sparse density behaves identically to
+// regular infill on the solid plane — same nozzle, same flow. Helpers
+// for sites that need to pick the right filament for that case.
+bool internal_solid_infill_uses_sparse_filament(const PrintRegionConfig &config, FlowRole role)
+{
+    return role == frSolidInfill && std::abs(config.sparse_infill_density.value - 100.) < EPSILON;
+}
+
+} // namespace
