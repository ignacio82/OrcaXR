+++ b/src/libslic3r/Extruder.cpp
@@ -204,6 +204,16 @@
 
 double Extruder::retract_length_toolchange() const
 {
+    // OrcaXR/FullSpectrum parity: a non-nil filament-level
+    // `filament_retract_length_toolchange[id]` overrides the printer-
+    // level `retract_length_toolchange[extruder_id]`. The key was added
+    // by Snapmaker Orca's fork and is what FullSpectrum users author
+    // their 5 mm-per-toolchange profiles with; before this patch the
+    // value silently dropped on the floor here and the printer default
+    // (usually 10 mm) ran, doubling wipe-tower retract activity.
+    const unsigned int filament_idx = m_id;
+    if (!m_config->filament_retract_length_toolchange.is_nil(filament_idx))
+        return m_config->filament_retract_length_toolchange.get_at(filament_idx);
     return m_config->retract_length_toolchange.get_at(extruder_id());
 }
 
