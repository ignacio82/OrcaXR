+inline void compute_poly_features(const double x[7], double out[330]) {
+    for (int i = 0; i < N_FEATURES; ++i) {
+        double val = 1.0;
+        for (int j = 0; j < N_INPUTS; ++j) {
+            if (POWERS[i][j] != 0) {
+                double base = x[j];
+                int exp = POWERS[i][j];
+                // Fast integer exponentiation (max exp = 4)
+                double p = 1.0;
+                for (int e = 0; e < exp; ++e)
+                    p *= base;
+                val *= p;
+            }
+        }
+        out[i] = val;
+    }
+}
