+	// OrcaXR Android (FullSpectrum patch 0036). Resolve through
+	// sparse_infill_filament_id_1based (honors the FS infill override
+	// + boundary-layer reversion), then check grouped manual_pattern
+	// first, fall back to LayerCycle resolve.
+	assert(region.config().wall_filament.value > 0);
+	const unsigned int filament_1based = (this->extruder_override == 0) ? sparse_infill_filament_id_1based(*this, region) : this->extruder_override;
+	const unsigned int grouped = grouped_manual_pattern_infill_filament_1based(*this, region, filament_1based);
+	return ((grouped != 0) ? grouped : resolve_mixed_1based(filament_1based)) - 1;
 }
 
