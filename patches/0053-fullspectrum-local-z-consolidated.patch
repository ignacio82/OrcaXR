+    struct PassState {
+        const LocalZWipeTowerPassRef *pass_ref { nullptr };
+        std::vector<unsigned int>     remaining_extruders;
+        size_t                        chain_idx { 0 };
+        size_t                        chain_pos { 0 };
+        bool                          ready { false };
+        bool                          completed { false };
