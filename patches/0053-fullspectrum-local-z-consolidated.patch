+        }
+    }
+
+    BOOST_LOG_TRIVIAL(info) << "Local-Z wipe tower dependency scheduler"
+                            << " start_extruder=" << start_extruder
+                            << " pass_count=" << pass_refs.size()
+                            << " chain_count=" << chains.size()
+                            << " toolchanges=" << toolchanges.size();
+    return toolchanges;
+}
