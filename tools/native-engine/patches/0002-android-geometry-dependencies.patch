Configure Android geometry dependencies with the target toolchain.

Autotools does not read CMake's NDK toolchain. Explicitly forward the selected
compiler/API triple and LLVM binutils to GMP and MPFR, and cap their make jobs.
Archive patches get their own Git root so they cannot resolve against the
engine's enclosing worktree. Enable the pinned OpenVDB Clang-syntax patch that its recipe omitted.
Disable OpenCV Android sample APKs alongside the existing examples flag.
Versions and algorithms remain unchanged.

Retire these branches when the pinned engine recipes forward an Android
Autotools toolchain, bound make concurrency and isolate archive patch roots.

---
diff --git a/deps/CGAL/CGAL.cmake b/deps/CGAL/CGAL.cmake
index ff8ea1f..839c0fd 100644
--- a/deps/CGAL/CGAL.cmake
+++ b/deps/CGAL/CGAL.cmake
@@ -2,6 +2,14 @@ if (IN_GIT_REPO)
     set(CGAL_DIRECTORY_FLAG --directory ${BINARY_DIR_REL}/dep_CGAL-prefix/src/dep_CGAL)
 endif ()
 
+# Archive patches must use the dependency root, not an enclosing worktree.
+set(_orcaxr_CGAL_patch git apply ${CGAL_DIRECTORY_FLAG} --verbose --ignore-space-change --whitespace=fix ${CMAKE_CURRENT_LIST_DIR}/0001-clang19.patch)
+if (ANDROID)
+    set(_orcaxr_CGAL_patch ${GIT_EXECUTABLE} init COMMAND ${GIT_EXECUTABLE} apply --verbose --ignore-space-change --whitespace=fix
+        ${CMAKE_CURRENT_LIST_DIR}/0001-clang19.patch
+    )
+endif()
+
 Snapmaker_Orca_add_cmake_project(
     CGAL
     # GIT_REPOSITORY https://github.com/CGAL/cgal.git
@@ -9,7 +17,7 @@ Snapmaker_Orca_add_cmake_project(
     # For whatever reason, this keeps downloading forever (repeats downloads if finished)
     URL      https://github.com/CGAL/cgal/archive/refs/tags/v5.4.zip
     URL_HASH SHA256=d7605e0a5a5ca17da7547592f6f6e4a59430a0bc861948974254d0de43eab4c0
-    PATCH_COMMAND git apply ${CGAL_DIRECTORY_FLAG} --verbose --ignore-space-change --whitespace=fix ${CMAKE_CURRENT_LIST_DIR}/0001-clang19.patch
+    PATCH_COMMAND ${_orcaxr_CGAL_patch}
     DEPENDS dep_Boost dep_GMP dep_MPFR
 )
 
diff --git a/deps/GMP/GMP.cmake b/deps/GMP/GMP.cmake
index 623f01a..9d44a99 100644
--- a/deps/GMP/GMP.cmake
+++ b/deps/GMP/GMP.cmake
@@ -59,14 +59,26 @@ else ()
         set(_cross_compile_arg --host=${TOOLCHAIN_PREFIX})
     endif ()
 
+    set(_gmp_make_jobs -j)
+    set(_gmp_patch ${CMAKE_CURRENT_LIST_DIR}/0001-GMP_GCC15.patch)
+    set(_gmp_patch_command git apply ${GMP_DIRECTORY_FLAG} --verbose ${_gmp_patch})
+    if (ANDROID)
+        set(_cross_compile_arg --host=${CMAKE_LIBRARY_ARCHITECTURE})
+        set(_gmp_build_tgt "")
+        set(_gmp_make_jobs -j${ORCAXR_BUILD_JOBS})
+        # The extracted dependency is outside the engine worktree. Give git
+        # apply its own root instead of interpreting paths in the outer repo.
+        set(_gmp_patch_command ${GIT_EXECUTABLE} init COMMAND ${GIT_EXECUTABLE} apply --verbose ${_gmp_patch})
+    endif()
+
     ExternalProject_Add(dep_GMP
         URL https://github.com/SoftFever/OrcaSlicer_deps/releases/download/gmp-6.2.1/gmp-6.2.1.tar.bz2
         URL_HASH SHA256=eae9326beb4158c386e39a356818031bd28f3124cf915f8c5b1dc4c7a36b4d7c
         DOWNLOAD_DIR ${DEP_DOWNLOAD_DIR}/GMP
-        PATCH_COMMAND git apply ${GMP_DIRECTORY_FLAG} --verbose ${CMAKE_CURRENT_LIST_DIR}/0001-GMP_GCC15.patch
+        PATCH_COMMAND ${_gmp_patch_command}
         BUILD_IN_SOURCE ON
-        CONFIGURE_COMMAND  env "CFLAGS=${_gmp_ccflags}" "CXXFLAGS=${_gmp_ccflags}" ./configure ${_cross_compile_arg} --enable-shared=no --enable-cxx=yes --enable-static=yes "--prefix=${DESTDIR}" ${_gmp_build_tgt}
-        BUILD_COMMAND     make -j
+        CONFIGURE_COMMAND ${CMAKE_COMMAND} -E env ${ORCAXR_AUTOTOOLS_ENV} "CFLAGS=${_gmp_ccflags}" "CXXFLAGS=${_gmp_ccflags}" ./configure ${_cross_compile_arg} --enable-shared=no --enable-cxx=yes --enable-static=yes "--prefix=${DESTDIR}" ${_gmp_build_tgt}
+        BUILD_COMMAND     make ${_gmp_make_jobs}
         INSTALL_COMMAND   make install
     )
 endif ()
