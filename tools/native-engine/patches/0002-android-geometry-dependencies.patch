diff --git a/deps/deps-android.cmake b/deps/deps-android.cmake
index e72f9ea..e240138 100644
--- a/deps/deps-android.cmake
+++ b/deps/deps-android.cmake
@@ -8,3 +8,13 @@ set(DEP_CMAKE_OPTS
     -DCMAKE_POLICY_VERSION_MINIMUM=3.5
     -DCMAKE_FIND_ROOT_PATH=${DESTDIR}
 )
+
+# Autotools does not consume a CMake toolchain. Forward the same NDK compiler,
+# API target and binutils explicitly; never let configure choose host GCC.
+set(ORCAXR_AUTOTOOLS_ENV
+    "CC=${CMAKE_C_COMPILER} --target=${CMAKE_C_COMPILER_TARGET}"
+    "CXX=${CMAKE_CXX_COMPILER} --target=${CMAKE_CXX_COMPILER_TARGET}"
+    "AR=${CMAKE_AR}"
+    "RANLIB=${CMAKE_RANLIB}"
+    "STRIP=${CMAKE_STRIP}"
+)
