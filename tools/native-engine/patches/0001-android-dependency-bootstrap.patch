diff --git a/deps/TBB/android-ndk.patch b/deps/TBB/android-ndk.patch
new file mode 100644
index 0000000..17a6de9
--- /dev/null
+++ b/deps/TBB/android-ndk.patch
@@ -0,0 +1,58 @@
+--- a/CMakeLists.txt
++++ b/CMakeLists.txt
+@@ -200,7 +200,11 @@
+     if (NOT "${CMAKE_SYSTEM_PROCESSOR}" MATCHES "mips")
+         if (TBBMALLOC_BUILD)
+             add_subdirectory(src/tbbmalloc)
+-            add_subdirectory(src/tbbmalloc_proxy)
++            # Android uses Bionic, not the glibc interposition ABI. The engine
++            # links tbbmalloc explicitly; do not replace process-wide malloc.
++            if (NOT ANDROID)
++                add_subdirectory(src/tbbmalloc_proxy)
++            endif()
+         endif()
+         if (APPLE)
+             message(STATUS "TBBBind build targets are disabled due to unsupported environment")
+@@ -259,7 +263,7 @@
+ if (ANDROID_PLATFORM)
+     if (${ANDROID_STL} STREQUAL "c++_shared")
+         configure_file(
+-        "${ANDROID_NDK}/sources/cxx-stl/llvm-libc++/libs/${ANDROID_ABI}/libc++_shared.so"
++        "${CMAKE_SYSROOT}/usr/lib/${CMAKE_LIBRARY_ARCHITECTURE}/libc++_shared.so"
+         "${CMAKE_LIBRARY_OUTPUT_DIRECTORY}/libc++_shared.so"
+         COPYONLY)
+     endif()
+--- a/src/tbbmalloc/def/lin64-tbbmalloc.def
++++ b/src/tbbmalloc/def/lin64-tbbmalloc.def
+@@ -54,20 +54,20 @@
+ *3tbb*;
+ *__TBB*;
+ __itt_*;
+-ITT_DoOneTimeInitialization;
+-TBB_runtime_interface_version;
++ITT_DoOneTimeInitialization*;
++TBB_runtime_interface_version*;
+ 
+ /* Intel Compiler (libirc) symbols */
+ __intel_*;
+ _intel_*;
+-get_memcpy_largest_cachelinesize;
+-get_memcpy_largest_cache_size;
+-get_mem_ops_method;
+-init_mem_ops_method;
+-irc__get_msg;
+-irc__print;
+-override_mem_ops_method;
+-set_memcpy_largest_cachelinesize;
+-set_memcpy_largest_cache_size;
++get_memcpy_largest_cachelinesize*;
++get_memcpy_largest_cache_size*;
++get_mem_ops_method*;
++init_mem_ops_method*;
++irc__get_msg*;
++irc__print*;
++override_mem_ops_method*;
++set_memcpy_largest_cachelinesize*;
++set_memcpy_largest_cache_size*;
+ 
+ };
diff --git a/deps/deps-android.cmake b/deps/deps-android.cmake
new file mode 100644
index 0000000..e72f9ea
--- /dev/null
+++ b/deps/deps-android.cmake
@@ -0,0 +1,10 @@
+# Forward the target identity to every nested CMake project. Otherwise the
+# NDK toolchain silently defaults a child to armeabi-v7a/API 21.
+set(DEP_CMAKE_OPTS
+    -DCMAKE_POSITION_INDEPENDENT_CODE=ON
+    -DANDROID_ABI=${ANDROID_ABI}
+    -DANDROID_PLATFORM=${ANDROID_PLATFORM}
+    -DANDROID_STL=${ANDROID_STL}
+    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
+    -DCMAKE_FIND_ROOT_PATH=${DESTDIR}
+)
