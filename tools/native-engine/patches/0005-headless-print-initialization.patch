-    bool m_isBBLPrinter;
+    bool m_isBBLPrinter {false};
 
     // Ordered collections of extrusion paths to build skirt loops and brim.
     ExtrusionEntityCollection               m_skirt;
@@ -1134,7 +1134,7 @@
