diff --git a/cmake/modules/FindOpenVDB.cmake b/cmake/modules/FindOpenVDB.cmake
index a091002..87bdc85 100644
--- a/cmake/modules/FindOpenVDB.cmake
+++ b/cmake/modules/FindOpenVDB.cmake
@@ -312,13 +312,21 @@ find_package_handle_standard_args(OpenVDB
 #  Determine ABI number
 # ------------------------------------------------------------------------
 
-# Set the ABI number the library was built against. Uses vdb_print
-find_program(OPENVDB_PRINT vdb_print PATHS ${OpenVDB_INCLUDE_DIR} )
-
-OPENVDB_ABI_VERSION_FROM_PRINT(
-  "${OPENVDB_PRINT}"
-  ABI OpenVDB_ABI
-)
+# Never execute an Android target binary on the build host. The installed
+# generated header records the ABI chosen by the dependency build.
+if(ANDROID)
+  file(STRINGS "${OpenVDB_INCLUDE_DIR}/openvdb/version.h" _orcaxr_vdb_abi_lines
+    REGEX "^#define[ \t]+OPENVDB_ABI_VERSION_NUMBER[ \t]+[0-9]+$")
+  list(LENGTH _orcaxr_vdb_abi_lines _orcaxr_vdb_abi_count)
+  if(NOT _orcaxr_vdb_abi_count EQUAL 1)
+    message(FATAL_ERROR "Cannot read the installed Android OpenVDB ABI")
+  endif()
+  string(REGEX REPLACE "^#define[ \t]+OPENVDB_ABI_VERSION_NUMBER[ \t]+" ""
+    OpenVDB_ABI "${_orcaxr_vdb_abi_lines}")
+else()
+  find_program(OPENVDB_PRINT vdb_print PATHS ${OpenVDB_INCLUDE_DIR} )
+  OPENVDB_ABI_VERSION_FROM_PRINT("${OPENVDB_PRINT}" ABI OpenVDB_ABI)
+endif()
 
 if(NOT OpenVDB_FIND_QUIETLY)
   if(NOT OpenVDB_ABI)
