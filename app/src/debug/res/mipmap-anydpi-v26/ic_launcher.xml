<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only adaptive launcher icon. Overlays the main source set's
  ic_launcher.xml via Android resource merging. Two distinguishing
  changes from the Play Store icon:
    1. Foreground rotated 180° (ic_launcher_foreground_dev / _monochrome_dev).
    2. Background switched from the brand image to a bright orange flat color.
  The pair makes a dev install impossible to confuse with the released
  build, even when the launcher applies themed icons or icon packs.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_dev_background"/>
  <foreground android:drawable="@drawable/ic_launcher_foreground_dev"/>
  <monochrome android:drawable="@drawable/ic_launcher_monochrome_dev"/>
</adaptive-icon>
