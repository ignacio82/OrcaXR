<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- XR target. required="false" so the APK installs on phones / emulators
         too (we fall back to a 2D Compose surface at runtime when the XR
         Session can't be created). -->
    <uses-feature
        android:name="android.software.xr.api.spatial"
        android:required="false" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Moonraker / OctoPrint upload + start-print over the local network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- MCP server foreground service — keeps the local HTTP/JSON-RPC
         endpoint alive when the user takes off the headset to drive
         OrcaXR from a phone-side companion app. Without this the server
         lives only in the Application singleton, which the OS will
         eventually reap once the Activity is gone. POST_NOTIFICATIONS is
         needed because Android 13+ requires a runtime grant to display
         the persistent "MCP server running" notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Optional in-app LLM assistant (Devices → AI assistant). Voice
         dictation routes through Android's SpeechRecognizer; we only
         ask for the mic permission when the user enables the voice
         toggle and taps the panel's mic button for the first time. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".OrcaXRApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App.Starting"
        android:allowBackup="false"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Hosts the MCP HTTP server so it survives headset removal. Stays
          tightly scoped to the user-toggled MCP feature: started only
          when the Devices → MCP switch is on, stopped immediately when
          the user flips it off. foregroundServiceType="dataSync" is the
          canonical pick for "I'm running a long-lived background data
          channel"; Android 14+ requires the type to be declared.
          Not exported — only McpController inside our process binds it.
        -->
        <service
            android:name=".mcp.McpForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
