<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- XR target. required="false" so the APK installs on phones / emulators
         too (we fall back to a 2D Compose surface at runtime when the XR
         Session can't be created). -->
    <uses-feature
        android:name="android.software.xr.api.spatial"
        android:required="false" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Moonraker / OctoPrint upload + start-print over the local network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- MCP server foreground service — keeps the local HTTP/JSON-RPC
         endpoint alive when the user takes off the headset to drive
         OrcaXR from a phone-side companion app. Without this the server
         lives only in the Application singleton, which the OS will
         eventually reap once the Activity is gone. POST_NOTIFICATIONS is
         needed because Android 13+ requires a runtime grant to display
         the persistent "MCP server running" notification.

         FOREGROUND_SERVICE_SPECIAL_USE is for the MCP server + the
         in-app assistant runner. Both are long-running services the
         user opted into; on Android 15+ (API 35+) the `dataSync` type
         carries a 6-hour-per-24h cumulative time limit, which the MCP
         "always-on local listener" use case will absolutely exhaust on
         a daily-driver setup. `specialUse` has no such cap, in
         exchange for shipping the SUBTYPE property below justifying
         the use. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Optional in-app LLM assistant (Devices → AI assistant). Voice
         dictation routes through Android's SpeechRecognizer; we only
         ask for the mic permission when the user enables the voice
         toggle and taps the panel's mic button for the first time. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Local on-device LLM (Devices → AI assistant → Local). The
         Gemma 4 .litertlm bundle is fetched as a foreground service
         download (~2.4 GiB for E2B, ~3.4 GiB for E4B) so a multi-GB
         pull survives the user backgrounding the app or doffing the
         headset. WAKE_LOCK is what WorkManager's expedited path uses
         under the hood to keep the CPU awake while the worker runs;
         FOREGROUND_SERVICE / DATA_SYNC / POST_NOTIFICATIONS are
         already declared above for the MCP server but apply equally
         to the model download worker. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".OrcaXRApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App.Starting"
        android:allowBackup="false"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Roadmap B14 — register OrcaXR as a system-wide opener for
              3MF / STL / OBJ / AMF / STEP files. A tap on a `.3mf` in
              a file manager / browser, a "share to" from MakerWorld or
              Bambu Handy, and Android's "Open with..." picker all flow
              through here. SharedIntentHandler drains the URI list out
              of the Intent and stages each one to cacheDir/shared/
              before MainActivity routes them through the same
              onFileSelected codepath the in-app picker uses. See
              ROADMAP.md B14 for the rationale (XR users genuinely live
              in the headset; making the slicer a registered share-
              target removes the only "leave the headset to import"
              friction in the AI-paint flow).

              launchMode="singleTask" so a share into an
              already-running OrcaXR routes through onNewIntent instead
              of spawning a second Activity instance — the latter would
              lose the user's current workspace state.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="model/3mf" />
                <data android:mimeType="application/x-3mf" />
                <data android:mimeType="application/vnd.ms-package.3dmanufacturing-3dmodel+xml" />
                <data android:mimeType="model/x-stl" />
                <data android:mimeType="model/stl" />
                <data android:mimeType="application/sla" />
                <data android:mimeType="model/obj" />
                <data android:mimeType="model/x-obj" />
                <data android:mimeType="model/amf" />
                <data android:mimeType="application/x-amf" />
                <data android:mimeType="model/step" />
                <data android:mimeType="application/step" />
            </intent-filter>
            <!--
              Some senders (Bambu Handy, the Pixel "Files" app on
              certain MIME types) hand us application/octet-stream and
              rely on the receiver to pattern-match the path. Combined
              host="*" + mimeType + pathPattern is the canonical Android
              shape for "I accept any path with this extension".
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.3mf" />
                <data android:pathPattern=".*\\.stl" />
                <data android:pathPattern=".*\\.STL" />
                <data android:pathPattern=".*\\.obj" />
                <data android:pathPattern=".*\\.amf" />
                <data android:pathPattern=".*\\.step" />
                <data android:pathPattern=".*\\.stp" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="model/3mf" />
                <data android:mimeType="application/x-3mf" />
                <data android:mimeType="application/vnd.ms-package.3dmanufacturing-3dmodel+xml" />
                <data android:mimeType="model/x-stl" />
                <data android:mimeType="model/stl" />
                <data android:mimeType="application/sla" />
                <data android:mimeType="model/obj" />
                <data android:mimeType="model/x-obj" />
                <data android:mimeType="model/amf" />
                <data android:mimeType="application/x-amf" />
                <data android:mimeType="model/step" />
                <data android:mimeType="application/step" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!--
              Quick Share / share-sheet target for the OrcaXR MCP grant
              snippet. The XR-side McpServerCard's Share button drops a
              short markdown blob (signature, endpoint URL, bearer
              token) onto a SEND intent with mimeType=text/plain; this
              filter makes OrcaXR a candidate in the receiving device's
              chooser so a single tap lands the headset's connection
              details on the phone — no copy-paste, no QR, no manual
              entry. Non-OrcaXR shared text is silently ignored at
              parse time (the snippet's signature line is required).
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          Phone / tablet entry point. NOT exported as a launcher — the
          system shows a single OrcaXR icon driven by MainActivity, and
          MainActivity.onCreate forwards here when Session.create
          returns null (i.e. the device isn't XR-capable). Forwarded
          intents may carry VIEW / SEND data so the file-share flow
          works on phones too.
        -->
        <!--
          supportsPictureInPicture: when the MCP server is running and
          the user hits Home, MobileActivity.onUserLeaveHint shrinks
          the workspace into PiP instead of going to onStop. Keeps
          WorkspaceBinding's `attached` flag true so a remote LLM
          driving OrcaXR over MCP doesn't lose the renderer-backed
          tools the moment the user pockets the phone.

          configChanges: PiP enter / exit triggers screenSize +
          screenLayout + smallestScreenSize + orientation reconfigs;
          listing them here lets us survive the transition without
          recreating the Activity (which would cancel the JNI BVH
          builds and reset the GL paint cache).
        -->
        <activity
            android:name=".MobileActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:theme="@style/Theme.App.Starting" />

        <!--
          Hosts the MCP HTTP server so it survives headset removal. Stays
          tightly scoped to the user-toggled MCP feature: started only
          when the Devices → MCP switch is on, stopped immediately when
          the user flips it off. foregroundServiceType="specialUse"
          because the MCP server is an always-on local listener — the
          user explicitly opts in (Devices → MCP) and expects it to stay
          up across a full session, including hours where the headset is
          doffed. Android 15+ caps `dataSync` at 6 hours of cumulative
          uptime per rolling 24h, which a daily-driver MCP setup will
          exhaust and then crash with ForegroundServiceStartNotAllowed
          on the next service refresh (port change, key rotate, app
          relaunch). `specialUse` carries no such cap; the SUBTYPE
          property below documents the use for Play.
          Not exported — only McpController inside our process binds it.
        -->
        <service
            android:name=".mcp.McpForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local MCP (Model Context Protocol) JSON-RPC server, opt-in via Devices → MCP, lets a companion app drive the slicer over the loopback network while the user has the XR headset off." />
        </service>

        <!--
          Roadmap E8 — keeps OrcaXR's process alive during a slice so
          the user can take off the XR headset mid-slice and have the
          result waiting when they return. SliceLifecycle starts/stops
          this service per slice (re-entrant counter under nested
          inner slices). Kept on `dataSync` because slicing is a
          finite, naturally-bounded operation (30-120s typical) — it
          will never legitimately exhaust the 6h/24h cap. The
          long-lived MCP server and the per-turn agent runner moved
          to specialUse so they don't consume slicing's quota. Not
          exported.
        -->
        <service
            android:name=".SliceForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Roadmap E8 — fielded by the Cancel action on the slicing
          foreground-service notification. Manifest-registered (not
          dynamic) so a tap from the lock screen / notification shade
          works even when the Activity has been torn down — the user-
          take-off-the-headset scenario the foreground service exists
          for. android:exported="false" because the only sender is
          OrcaXR itself; nothing else in the device-wide intent space
          should be able to fire it.
        -->
        <receiver
            android:name=".SliceCancelReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.orcaxr.app.action.SLICE_CANCEL" />
            </intent-filter>
        </receiver>

        <!--
          WorkManager's SystemForegroundService ships without a
          foregroundServiceType attribute. Android 14+ rejects any
          startForeground(type=…) call whose type isn't a subset of
          the manifest declaration, so we override that service entry
          to declare `dataSync` (matches the type
          Gemma4DownloadWorker.createForegroundInfo passes in
          ForegroundInfo). tools:node="merge" overlays this onto the
          androidx.work-provided manifest entry rather than replacing
          it wholesale.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!--
          Foreground service that keeps the process alive while the
          in-app assistant is mid-turn. AgentRunner starts it on send()
          and stops it on Idle. Not exported — only OrcaXR's own
          AgentRunner binds to it.

          foregroundServiceType="specialUse" rather than dataSync — a
          chained MCP turn can run for many minutes (slice → render →
          paint → upload to Moonraker), and the MCP server runs in the
          same process so the two services share the same `dataSync`
          quota when both are typed that way. Quota exhaustion in
          either one would deny startForeground for both. The agent
          runner is the canonical "user explicitly fired this off and
          expects it to keep running" use case `specialUse` exists for.
        -->
        <service
            android:name=".llm.runner.AgentForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="In-app AI assistant turn runner — keeps the process alive while the user-initiated assistant turn drives MCP tools (slice, render, upload). Stops as soon as the runner enters Idle." />
        </service>
    </application>
</manifest>
