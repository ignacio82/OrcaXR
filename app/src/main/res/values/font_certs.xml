<?xml version="1.0" encoding="utf-8"?>
<!--
    Certificate hashes for the Google Play Services font provider used by
    androidx.compose.ui:ui-text-google-fonts. Pulled from the canonical
    res/values/font_certs.xml that AGP's font-downloader template ships
    (mirrors what `Settings → Font` in Android Studio writes when wiring
    a downloadable Google Font).

    Two certs (release + dev) so the lookup succeeds against any GMS
    build the headset image happens to ship. Without these the
    GoogleFont.Provider constructor throws IllegalStateException at
    first composition.
-->
<resources>
    <array name="com_google_android_gms_fonts_certs">
        <item>@array/com_google_android_gms_fonts_certs_dev</item>
        <item>@array/com_google_android_gms_fonts_certs_prod</item>
    </array>
    <string-array name="com_google_android_gms_fonts_certs_dev">
        <item>
            
        </item>
    </string-array>
    <string-array name="com_google_android_gms_fonts_certs_prod">
        <item>
            
        </item>
    </string-array>
</resources>
