+// OrcaXR Phase D.2 (PR #222 port): pick the toolchange index whose extruder
+// will draw the wipe-tower wall (finish_layer). Three priorities, in order:
+//   1. Same material as the previous layer's wall — preferring the exact
+//      same physical extruder, then falling back to a different extruder
+//      that shares the material.
+//   2. A material that also appears in the next layer — reduces the number
+//      of material switches the next layer will need on its wall.
+//   3. Original behavior: first non-soluble toolchange, else old_tool.
+//
+// Returns idx >= 0 (wall drawn after tool_changes[idx]) or -1 (wall drawn
+// before any toolchange, using m_current_tool).
+int WipeTower2::select_wall_extruder_idx(
+        const std::vector<WipeTowerInfo::ToolChange>& tool_changes,
+        const WipeTowerInfo* next_layer_info) const
+{
+    struct Candidate {
+        int    idx;
+        size_t tool;
+    };
