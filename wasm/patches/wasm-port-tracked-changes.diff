+    // OrcaXR FS-parity: PR #222 D.2's wall-continuity optimization steers
+    // wipe-tower brim/empty-grid extrusion onto whichever extruder drew the
+    // previous layer's wall — useful when filaments use different materials,
+    // but in same-material prints (e.g., all PLA) it just sticks the wall to
+    // the initial extruder for the whole print, mis-attributing ~150 mm of
+    // prime-tower material vs FS upstream. Skip D.2 when no material switch
+    // can be saved (all non-soluble filaments share a material) and use FS
+    // upstream's first_toolchange_to_nonsoluble instead. The full D.2 logic
+    // below still runs for genuinely mixed-material prints.
+    bool any_material_differs = false;
+    if (!m_filpar.empty()) {
+        const std::string& mat0 = m_filpar.front().material;
+        for (const auto& fp : m_filpar) {
+            if (!fp.is_soluble && fp.material != mat0) {
+                any_material_differs = true;
+                break;
+            }
+        }
+    }
+    if (!any_material_differs)
+        return first_toolchange_to_nonsoluble(tool_changes);
+
+    std::vector<Candidate> candidates;
+    if (m_current_tool < m_filpar.size() && !m_filpar[m_current_tool].is_soluble)
+        candidates.push_back({-1, m_current_tool});
+    for (size_t i = 0; i < tool_changes.size(); ++i) {
+        const size_t t = tool_changes[i].new_tool;
+        if (t < m_filpar.size() && !m_filpar[t].is_soluble)
+            candidates.push_back({int(i), t});
+    }
+
+    if (candidates.empty())
+        return -1;
+
+    // Priority 1: same material as previous layer's wall.
+    if (m_last_wall_extruder >= 0 && size_t(m_last_wall_extruder) < m_filpar.size()) {
+        const std::string& last_material = m_filpar[m_last_wall_extruder].material;
+        int best = -2;
+        for (const Candidate& c : candidates) {
+            if (m_filpar[c.tool].material != last_material)
+                continue;
+            if (c.tool == size_t(m_last_wall_extruder))
+                return c.idx;
+            if (best == -2)
+                best = c.idx;
+        }
+        if (best != -2)
+            return best;
+    }
+
+    // Priority 2: material that also appears in the next layer.
+    if (next_layer_info && !next_layer_info->tool_changes.empty()) {
+        std::vector<std::string> next_materials;
+        std::vector<size_t>      next_extruders;
+        const size_t front_old = next_layer_info->tool_changes.front().old_tool;
+        if (front_old < m_filpar.size()) {
+            next_materials.push_back(m_filpar[front_old].material);
+            next_extruders.push_back(front_old);
+        }
+        for (const auto& tc : next_layer_info->tool_changes) {
+            if (tc.new_tool < m_filpar.size()) {
+                next_materials.push_back(m_filpar[tc.new_tool].material);
+                next_extruders.push_back(tc.new_tool);
+            }
+        }
+
+        int best = -2;
+        for (const Candidate& c : candidates) {
+            const std::string& mat = m_filpar[c.tool].material;
+            if (std::find(next_materials.begin(), next_materials.end(), mat) == next_materials.end())
+                continue;
+            if (std::find(next_extruders.begin(), next_extruders.end(), c.tool) != next_extruders.end())
+                return c.idx;
+            if (best == -2)
+                best = c.idx;
+        }
+        if (best != -2)
+            return best;
+    }
+
+    // Priority 3: fall back to the original heuristic, then to old_tool.
+    const int fallback = first_toolchange_to_nonsoluble(tool_changes);
+    if (fallback >= 0)
+        return fallback;
+    return candidates.front().idx;
+}
