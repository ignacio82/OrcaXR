diff --git a/deps/Boost/Boost.cmake b/deps/Boost/Boost.cmake
index a374004f97..0b7d647795 100644
--- a/deps/Boost/Boost.cmake
+++ b/deps/Boost/Boost.cmake
@@ -10,12 +10,37 @@ if (APPLE AND CMAKE_OSX_ARCHITECTURES)
     set(_context_arch_line "-DBOOST_CONTEXT_ARCHITECTURE:STRING=${CMAKE_OSX_ARCHITECTURES}")
 endif ()
 
+# OrcaXR WASM: prune Boost libs that can't build under Emscripten and that
+# libslic3r never links — context/coroutine* carry x86 asm; asio requires
+# context; process spawns children. boost_log's only asio use is its
+# non-native syslog backend, so that backend is disabled below instead.
+set(_orcaxr_boost_exclude "contract|fiber|numpy|stacktrace|wave|test")
+set(_orcaxr_boost_extra_args "")
+set(_orcaxr_boost_patch "")
+if (EMSCRIPTEN)
+    string(APPEND _orcaxr_boost_exclude
+        "|context|coroutine|coroutine2|asio|process|cobalt|graph_parallel|mpi")
+    # BOOST_LOG_NO_ASIO compiles out boost_log_setup's TCP/UDP sink-address
+    # parsing (init_from_settings.cpp), the one TU that #includes asio
+    # headers with asio excluded from the build.
+    set(_orcaxr_boost_extra_args
+        "-DBOOST_LOG_WITHOUT_SYSLOG:BOOL=ON"
+        "-DCMAKE_CXX_FLAGS:STRING=-pthread -fwasm-exceptions -DBOOST_LOG_NO_ASIO")
+    # boost_log/boost_log_setup link Boost::asio UNCONDITIONALLY even though
+    # only the (disabled) syslog backend compiles asio code — drop the
+    # dangling reference so asio/context can stay excluded.
+    set(_orcaxr_boost_patch
+        PATCH_COMMAND sed -i -e "s/Boost::asio//g" libs/log/CMakeLists.txt)
+endif ()
+
 orcaslicer_add_cmake_project(Boost
     URL "https://github.com/boostorg/boost/releases/download/boost-1.84.0/boost-1.84.0.tar.gz"
     URL_HASH SHA256=4d27e9efed0f6f152dc28db6430b9d3dfb40c0345da7342eaa5a987dde57bd95
     LIST_SEPARATOR |
+    ${_orcaxr_boost_patch}
     CMAKE_ARGS
-        -DBOOST_EXCLUDE_LIBRARIES:STRING=contract|fiber|numpy|stacktrace|wave|test
+        -DBOOST_EXCLUDE_LIBRARIES:STRING=${_orcaxr_boost_exclude}
+        ${_orcaxr_boost_extra_args}
         -DBOOST_LOCALE_ENABLE_ICU:BOOL=OFF # do not link to libicu, breaks compatibility between distros
         -DBUILD_TESTING:BOOL=OFF
         -DBOOST_IOSTREAMS_ENABLE_ZSTD:BOOL=OFF
diff --git a/deps/CMakeLists.txt b/deps/CMakeLists.txt
index a90de994db..0c25a904d5 100644
--- a/deps/CMakeLists.txt
+++ b/deps/CMakeLists.txt
@@ -45,6 +45,56 @@ if (CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_VERSION VERSION_LESS "3.25")
     set(LINUX ON CACHE BOOL "" FORCE)
 endif ()
 
+# OrcaXR: set TOOLCHAIN_PREFIX for Android so autotools-based deps
+# (GMP, MPFR, OpenSSL) get a correct --host / --cross-compile-prefix.
+# The NDK's android.toolchain.cmake does not set this; several of
+# OrcaSlicer's dep recipes assume it is defined by the toolchain file.
+if (ANDROID AND NOT TOOLCHAIN_PREFIX)
+    if (CMAKE_ANDROID_ARCH_ABI STREQUAL "arm64-v8a")
+        set(TOOLCHAIN_PREFIX "aarch64-linux-android")
+    elseif (CMAKE_ANDROID_ARCH_ABI STREQUAL "armeabi-v7a")
+        set(TOOLCHAIN_PREFIX "armv7a-linux-androideabi")
+    elseif (CMAKE_ANDROID_ARCH_ABI STREQUAL "x86_64")
+        set(TOOLCHAIN_PREFIX "x86_64-linux-android")
+    elseif (CMAKE_ANDROID_ARCH_ABI STREQUAL "x86")
+        set(TOOLCHAIN_PREFIX "i686-linux-android")
+    endif()
+    message(STATUS "OrcaXR Android: TOOLCHAIN_PREFIX=${TOOLCHAIN_PREFIX}")
+endif()
+
+# OrcaXR: Android sub-build forwarding.
+# (a) The NDK r27+ provides a plain `clang` binary — the target triple
+#     is delivered via --target on the command line, set by the NDK
+#     toolchain file. Autotools-based deps (GMP, MPFR) bypass CMake and
+#     invoke `env CC=${CMAKE_C_COMPILER}` directly, so they lose --target
+#     and compile for the HOST (x86_64). Point them at the triple-named
+#     wrappers (aarch64-linux-android31-clang) that bake the target in.
+# (b) ExternalProject_Add sub-builds that DO use CMake don't inherit
+#     ANDROID_ABI / ANDROID_PLATFORM cache variables from the parent —
+#     the NDK toolchain file then defaults to armeabi-v7a (32-bit).
+#     Forward them explicitly via _orcaxr_android_args.
+set(ORCAXR_ANDROID_CC "")
+set(ORCAXR_ANDROID_CXX "")
+set(_orcaxr_android_args "")
+if (ANDROID)
+    string(REGEX REPLACE "^android-" "" _orcaxr_android_api "${ANDROID_PLATFORM}")
+    set(_orcaxr_ndk_bin "${ANDROID_NDK}/toolchains/llvm/prebuilt/linux-x86_64/bin")
+    set(ORCAXR_ANDROID_CC  "${_orcaxr_ndk_bin}/${TOOLCHAIN_PREFIX}${_orcaxr_android_api}-clang")
+    set(ORCAXR_ANDROID_CXX "${_orcaxr_ndk_bin}/${TOOLCHAIN_PREFIX}${_orcaxr_android_api}-clang++")
+    set(_orcaxr_android_args
+        -DANDROID_ABI:STRING=${ANDROID_ABI}
+        -DANDROID_PLATFORM:STRING=${ANDROID_PLATFORM}
+        # NDK toolchain file sets CMAKE_FIND_ROOT_PATH_MODE_PACKAGE=ONLY
+        # by default, restricting find_package to CMAKE_FIND_ROOT_PATH
+        # (the NDK sysroot). Our destdir (where Boost/TBB/OpenEXR land)
+        # is outside that root. Relax to BOTH so sub-builds like OpenVDB
+        # can find_package(Boost) via our BoostConfig.cmake.
+        -DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE:STRING=BOTH
+        -DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY:STRING=BOTH
+        -DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE:STRING=BOTH)
+    message(STATUS "OrcaXR Android: CC=${ORCAXR_ANDROID_CC}")
+endif()
+
 include(ExternalProject)
 include(ProcessorCount)
 
@@ -195,6 +245,7 @@ if (NOT IS_CROSS_COMPILE OR NOT APPLE)
             -DCMAKE_MODULE_LINKER_FLAGS:STRING=${CMAKE_MODULE_LINKER_FLAGS}
             -DBUILD_SHARED_LIBS:BOOL=OFF
             ${_cmake_osx_arch}
+            ${_orcaxr_android_args}
             "${_configs_line}"
             ${DEP_CMAKE_OPTS}
             ${P_ARGS_CMAKE_ARGS}
@@ -236,6 +287,7 @@ else()
             -DCMAKE_IGNORE_PREFIX_PATH:STRING=${CMAKE_IGNORE_PREFIX_PATH}
             -DBUILD_SHARED_LIBS:BOOL=OFF
             ${_cmake_osx_arch}
+            ${_orcaxr_android_args}
             "${_configs_line}"
             ${DEP_CMAKE_OPTS}
             ${P_ARGS_CMAKE_ARGS}
@@ -323,10 +375,18 @@ include(Boost/Boost.cmake)
