diff --git a/deps/EXPAT/EXPAT.cmake b/deps/EXPAT/EXPAT.cmake
index fd5c4c5c4d..3240054fbe 100644
--- a/deps/EXPAT/EXPAT.cmake
+++ b/deps/EXPAT/EXPAT.cmake
@@ -1,7 +1,18 @@
+# OrcaXR WASM: expat's entropy-source detection finds nothing under
+# Emscripten and #errors out. Entropy only salts expat's internal hash
+# (DoS hardening for untrusted XML); we parse local project files, so the
+# fallback is acceptable. Keep -pthread (must match every other object).
+set(_orcaxr_expat_flags "")
+if (EMSCRIPTEN)
+    set(_orcaxr_expat_flags "-DCMAKE_C_FLAGS:STRING=-pthread -fwasm-exceptions -DXML_POOR_ENTROPY=1")
+endif ()
+
