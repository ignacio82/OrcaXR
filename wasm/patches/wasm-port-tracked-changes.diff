diff --git a/deps/GMP/GMP.cmake b/deps/GMP/GMP.cmake
index b3ba181753..381a51a1ee 100644
--- a/deps/GMP/GMP.cmake
+++ b/deps/GMP/GMP.cmake
@@ -49,24 +49,55 @@ else ()
             set(_gmp_build_tgt armv7)
         endif()
         set(_gmp_build_tgt "--build=${_gmp_build_tgt}-pc-linux-gnu")
+    elseif(ANDROID)
+        # Cross-compiling to Android via NDK. autotools on the build host
+        # otherwise guesses the build machine's arch (x86_64) and tries to
+        # link x86_64 .asm files. Force a conservative generic build:
+        # disable hand-tuned assembly and let config.sub normalize the
+        # host triple from TOOLCHAIN_PREFIX (set in deps/CMakeLists.txt).
+        set(_gmp_build_tgt "--disable-assembly")
+    elseif(EMSCRIPTEN)
+        # OrcaXR WASM: generic C build, no hand-tuned assembly, and a
+        # neutral host triple (autotools otherwise guesses the build
+        # machine's x86_64 and mis-probes the compiler). Also drop the
+        # C-only warning flags from CXXFLAGS — GMP's configure runs its
+        # C++ probe with them and em++ rejects the probe.
+        # Explicit build≠host forces cross_compiling=yes so configure skips
+        # its run-the-binary probes (a WASM a.out can't exec on the host —
+        # "C++ compiler not available ... program does not run").
+        set(_gmp_build_tgt --disable-assembly --host=none --build=x86_64-pc-linux-gnu)
+        set(_gmp_ccflags "-O2 -DNDEBUG -fPIC -DPIC -pthread -fwasm-exceptions -fno-common")
     else ()
         set(_gmp_build_tgt "") # let it guess
     endif()
 
     set(_cross_compile_arg "")
-    if (CMAKE_CROSSCOMPILING)
+    if (CMAKE_CROSSCOMPILING AND NOT EMSCRIPTEN)
         # TOOLCHAIN_PREFIX should be defined in the toolchain file
         set(_cross_compile_arg --host=${TOOLCHAIN_PREFIX})
     endif ()
 
+    # OrcaXR: on Android, CMAKE_C_COMPILER is plain `clang` and the target
+    # triple is applied only via --target set by the NDK toolchain file.
+    # autotools bypasses CMake and invokes CC=clang directly, so it loses
+    # the target and compiles for the HOST. Use the NDK's triple-prefixed
+    # wrapper (aarch64-linux-android31-clang) which bakes --target in.
+    if (ANDROID)
+        set(_gmp_cc "${ORCAXR_ANDROID_CC}")
+        set(_gmp_cxx "${ORCAXR_ANDROID_CXX}")
+    else()
+        set(_gmp_cc "${CMAKE_C_COMPILER}")
+        set(_gmp_cxx "${CMAKE_CXX_COMPILER}")
+    endif()
+
     ExternalProject_Add(dep_GMP
         URL https://github.com/SoftFever/OrcaSlicer_deps/releases/download/gmp-6.2.1/gmp-6.2.1.tar.bz2
         URL_HASH SHA256=eae9326beb4158c386e39a356818031bd28f3124cf915f8c5b1dc4c7a36b4d7c
         DOWNLOAD_DIR ${DEP_DOWNLOAD_DIR}/GMP
         PATCH_COMMAND git apply ${GMP_DIRECTORY_FLAG} --verbose ${CMAKE_CURRENT_LIST_DIR}/0001-GMP_GCC15.patch
         BUILD_IN_SOURCE ON
-        CONFIGURE_COMMAND  env "CC=${CMAKE_C_COMPILER}" "CXX=${CMAKE_CXX_COMPILER}" "CFLAGS=${_gmp_ccflags}" "CXXFLAGS=${_gmp_ccflags}" "LDFLAGS=${CMAKE_EXE_LINKER_FLAGS}" ./configure ${_cross_compile_arg} --enable-shared=no --enable-cxx=yes --enable-static=yes "--prefix=${DESTDIR}" ${_gmp_build_tgt}
-        BUILD_COMMAND     make -j
-        INSTALL_COMMAND   make install
+        CONFIGURE_COMMAND  env "CC=${_gmp_cc}" "CXX=${_gmp_cxx}" "CFLAGS=${_gmp_ccflags}" "CXXFLAGS=${_gmp_ccflags}" "LDFLAGS=${CMAKE_EXE_LINKER_FLAGS}" ./configure ${_cross_compile_arg} --enable-shared=no --enable-cxx=yes --enable-static=yes "--prefix=${DESTDIR}" ${_gmp_build_tgt}
+        BUILD_COMMAND     make -j MAKEINFO=true
+        INSTALL_COMMAND   make install MAKEINFO=true
     )
 endif ()
