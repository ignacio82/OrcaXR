     std::vector<unsigned int> extruders;
     extruders.reserve(m_print_regions.size() * m_objects.size() * 3);
 
+    // OrcaXR Android (FullSpectrum integration). Painted face state IDs
+    // and region wall_filament values may reference virtual mixed-filament
+    // rows (id > num_physical). Downstream callers iterate this vector to
+    // size per-extruder buffers and to look up per-extruder config values
+    // (filament_temperature, retraction_length, ...) by index, so virtual
+    // IDs would OOB. Expand a virtual ID into its physical component IDs
+    // (component_a + component_b for the matching MixedFilament row) so
+    // every entry in `extruders` is a real physical extruder.
+    const size_t num_physical = m_config.filament_diameter.size();
+    const MixedFilamentManager &mixed_mgr = this->mixed_filament_manager();
+    auto append_physical_or_expand = [&extruders, num_physical, &mixed_mgr](unsigned int id_1based) {
+        if (id_1based == 0)
+            return;
+        if (id_1based <= num_physical) {
+            extruders.push_back(id_1based - 1);
+            return;
+        }
+        const MixedFilament *mf = mixed_mgr.mixed_filament_from_id(id_1based, num_physical);
+        if (mf != nullptr) {
+            if (mf->component_a >= 1 && mf->component_a <= num_physical)
+                extruders.push_back(mf->component_a - 1);
+            if (mf->component_b >= 1 && mf->component_b <= num_physical && mf->component_b != mf->component_a)
+                extruders.push_back(mf->component_b - 1);
+        }
+    };
+
