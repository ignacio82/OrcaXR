+        for (ExtrusionPath &p : mp->paths) p.wave_overhang_floor = true;
+    } else if (auto *coll = dynamic_cast<ExtrusionEntityCollection*>(ent)) {
+        for (ExtrusionEntity *child : coll->entities)
