diff --git a/deps/Boost/Boost.cmake b/deps/Boost/Boost.cmake
index d0086f2..4aef4eb 100644
--- a/deps/Boost/Boost.cmake
+++ b/deps/Boost/Boost.cmake
@@ -10,12 +10,37 @@ if (APPLE AND CMAKE_OSX_ARCHITECTURES)
     set(_context_arch_line "-DBOOST_CONTEXT_ARCHITECTURE:STRING=${CMAKE_OSX_ARCHITECTURES}")
 endif ()
 
+# OrcaXR WASM: prune Boost libs that can't build under Emscripten and that
+# libslic3r never links — context/coroutine* carry x86 asm; asio requires
+# context; process spawns children. boost_log's only asio use is its
+# non-native syslog backend, so that backend is disabled below instead.
+set(_orcaxr_boost_exclude "contract|fiber|numpy|stacktrace|wave|test")
+set(_orcaxr_boost_extra_args "")
+set(_orcaxr_boost_patch "")
+if (EMSCRIPTEN)
+    string(APPEND _orcaxr_boost_exclude
+        "|context|coroutine|coroutine2|asio|process|cobalt|graph_parallel|mpi")
+    # BOOST_LOG_NO_ASIO compiles out boost_log_setup's TCP/UDP sink-address
+    # parsing (init_from_settings.cpp), the one TU that #includes asio
+    # headers with asio excluded from the build.
+    set(_orcaxr_boost_extra_args
+        "-DBOOST_LOG_WITHOUT_SYSLOG:BOOL=ON"
+        "-DCMAKE_CXX_FLAGS:STRING=-pthread -fwasm-exceptions -DBOOST_LOG_NO_ASIO")
+    # boost_log/boost_log_setup link Boost::asio UNCONDITIONALLY even though
+    # only the (disabled) syslog backend compiles asio code — drop the
+    # dangling reference so asio/context can stay excluded.
+    set(_orcaxr_boost_patch
+        PATCH_COMMAND sed -i -e "s/Boost::asio//g" libs/log/CMakeLists.txt)
+endif ()
+
 Snapmaker_Orca_add_cmake_project(Boost
     URL "https://github.com/boostorg/boost/releases/download/boost-1.84.0/boost-1.84.0.tar.gz"
     URL_HASH SHA256=4d27e9efed0f6f152dc28db6430b9d3dfb40c0345da7342eaa5a987dde57bd95
     LIST_SEPARATOR |
+    ${_orcaxr_boost_patch}
     CMAKE_ARGS
-        -DBOOST_EXCLUDE_LIBRARIES:STRING=contract|fiber|numpy|stacktrace|wave|test
+        -DBOOST_EXCLUDE_LIBRARIES:STRING=${_orcaxr_boost_exclude}
+        ${_orcaxr_boost_extra_args}
         -DBOOST_LOCALE_ENABLE_ICU:BOOL=OFF # do not link to libicu, breaks compatibility between distros
         -DBUILD_TESTING:BOOL=OFF
         "${_context_abi_line}"
