diff --git a/deps/deps-linux.cmake b/deps/deps-linux.cmake
index fbe7b71..7a8809c 100644
--- a/deps/deps-linux.cmake
+++ b/deps/deps-linux.cmake
@@ -1,6 +1,27 @@
 
 set(DEP_CMAKE_OPTS "-DCMAKE_POSITION_INDEPENDENT_CODE=ON")
 
+# OrcaXR WASM: compile every dep with pthread support (Emscripten lowers
+# atomics/TLS differently per -pthread, so ALL objects in the final link
+# must agree). Threads back TBB-parallel slicing via SharedArrayBuffer;
+# the web app must be served with COOP/COEP headers.
+if (EMSCRIPTEN)
+    list(APPEND DEP_CMAKE_OPTS
+        "-DCMAKE_C_FLAGS:STRING=-pthread -fwasm-exceptions"
+        "-DCMAKE_CXX_FLAGS:STRING=-pthread -fwasm-exceptions"
+        # The Emscripten toolchain restricts find_* to its sysroot, so deps
+        # can't see the libs already installed in our DESTDIR (PNG failing
+        # to find our ZLIB, CGAL failing to find GMP, …). Same fix the
+        # Android build applies at the libslic3r stage.
+        "-DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=BOTH"
+        "-DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=BOTH"
+        "-DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=BOTH"
+        # Host CMake 4.x refuses sub-projects whose cmake_minimum_required
+        # is < 3.5 (vendored expat & co) without this escape hatch.
+        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
+    )
+endif ()
+
 include("deps-unix-common.cmake")
 
 # Some Linuxes may have very old libpng, so it's best to bundle it instead of relying on the system version.
