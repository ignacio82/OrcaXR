+
+// OrcaXR: CLI-safe variant of expand_plate_extruders — builds the mixed-
+// filament table from the fully-merged print config (project settings)
+// instead of the GUI preset bundle, mirroring PrintApply's manager init
+// (clear + auto_generate + load_custom_entries).
+static void expand_plate_extruders_from_config(std::vector<int>& ids, const DynamicPrintConfig& full_config)
+{
+	const auto *colours = full_config.option<ConfigOptionStrings>("filament_colour");
+	const size_t num_physical = colours == nullptr ? 0 : colours->values.size();
+	if (num_physical == 0)
+		return;
+	MixedFilamentManager mgr;
+	mgr.clear_custom_entries();
+	mgr.auto_generate(colours->values);
+	if (const auto *defs = full_config.option<ConfigOptionString>("mixed_filament_definitions");
+	    defs != nullptr && !defs->value.empty())
+		mgr.load_custom_entries(defs->value, colours->values);
+	mgr.expand_virtual_extruder_ids(ids, num_physical);
+	std::sort(ids.begin(), ids.end());
+	ids.erase(std::unique(ids.begin(), ids.end()), ids.end());
+}
