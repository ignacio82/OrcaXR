{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orcaxr.martinez.fyi/contracts/core-protocol-v1",
  "title": "OrcaXR core canonical request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "requestId", "operation", "input"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+(?![\\s\\S])" },
    "operation": { "const": "canonicalize" },
    "input": { "type": "string" }
  },
  "x-orcaxr": {
    "coreAbiVersion": 1,
    "canonicalEncodingVersion": 1,
    "maxRequestBytes": 8388608,
    "maxInputBytes": 1048576,
    "maxOutputBytes": 6291456
  }
}
