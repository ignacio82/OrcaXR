{
  "version": 1,
  "policy": {
    "resources": "Each Android string resource (android/app/src/main/res/values) that carries a browser message's English maps to that message's key: tools/cross-platform/android-strings.mjs checks the English is still exactly the browser's and writes the translations (values-*/) from web/public/l10n. Mapped by role as well as words: equal English for a different control is declined with a reason. Arguments list the message's ICU arguments in %1$s, %2$s order; every argument is text the host formats as the browser does (a number as `{n, number}`), and a plural's form is chosen by its integer quantity.",
    "english": "Resources no browser message carries. They stay English in every language, as a message missing from the browser's catalogue does, until the browser has a message for them.",
    "kotlin": "Kotlin literals of the app that carry a browser message's words, kept in Kotlin for the reason named; the generator checks each still says exactly what the browser says. A new one fails until it becomes a mapped resource or is recorded here.",
    "declined": "Equal English that is not the same message: never mapped, and never reported again while its words are unchanged."
  },
  "reasons": {
    "model": "Status text a ViewModel or workflow composes off the composition; it holds no Resources, and the text is checked through it.",
    "tested": "Platform-free words the JVM tests check through the class that composes them (PrepareFlowTest, SendFlowTest)."
  },
